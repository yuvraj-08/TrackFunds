{
  "name": "trackfunds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TrackFunds monorepo starter with a production-ready Next.js web app and shared packages.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules .turbo .pnpm-store apps\\web\\.next packages\\*\\dist apps\\*\\dist",
    "db:generate": "pnpm --filter @trackfunds/database db:generate",
    "db:migrate": "pnpm --filter @trackfunds/database db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@trackfunds/config": "workspace:*",
    "eslint": "^9.39.2",
    "globals": "^16.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.1",
    "turbo": "^2.8.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
