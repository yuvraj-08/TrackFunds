{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-with-env.mjs node --watch --import @swc-node/register/esm-register src/main.ts",
    "prebuild": "pnpm --filter @trackfunds/database build && pnpm --filter @trackfunds/types build",
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "start": "node ../../scripts/run-with-env.mjs node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "pretypecheck": "pnpm --filter @trackfunds/database build && pnpm --filter @trackfunds/types build",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@trackfunds/database": "workspace:*",
    "@trackfunds/types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.44.7",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "nodemailer": "^8.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.33",
    "@swc/helpers": "^0.5.21",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^7.0.11",
    "tsx": "^4.20.6"
  }
}
